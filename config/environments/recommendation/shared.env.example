# Same dispatch values on both Control API/worker hosts. No credentials in Git.
C_LOCAL_DEMO=0
INTEGRATION_ENABLED=1
SEARCH_MAX_CANDIDATES=0
SEARCH_SECONDS=45
RECOMMENDATION_QUEUE=all
RECOMMENDATION_WORKER_IDLE_SECONDS=1
RECOMMENDATION_LEASE_SECONDS=30
RECOMMENDATION_HEARTBEAT_SECONDS=10
RECOMMENDATION_JOB_TIMEOUT_SECONDS=180
RECOMMENDATION_MAX_RECOVERIES=2
RECOMMENDATION_MAX_QUEUED_RULE=100
RECOMMENDATION_MAX_QUEUED_GEMINI=20
GEMINI_ENABLED=1
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_CANDIDATES=400
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_MAX_CONCURRENT=1
GEMINI_MIN_INTERVAL_SECONDS=2
# Set each host's exact private bind IP before enabling its API unit.
API_BIND_HOST=
