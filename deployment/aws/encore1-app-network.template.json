{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Application-only network additions for the existing cluster; preserve all foundation stacks and databases.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "TargetGroup1": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "Source1": {
      "Type": "String",
      "AllowedPattern": "pl-[a-z0-9]+"
    },
    "TargetGroup2": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "Source2": {
      "Type": "String",
      "AllowedPattern": "\\d{1,3}(\\.\\d{1,3}){3}/32"
    },
    "TargetGroup3": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "Source3": {
      "Type": "String",
      "AllowedPattern": "\\d{1,3}(\\.\\d{1,3}){3}/32"
    }
  },
  "Resources": {
    "ApplicationIngress1": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "CloudFront origin to temporary ALB",
          "must": [
            "Existing owned destination group only",
            "No unrestricted CIDR",
            "Remove this stack before deleting foundation groups"
          ]
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "TargetGroup1"
        },
        "IpProtocol": "tcp",
        "FromPort": 80,
        "ToPort": 80,
        "SourcePrefixListId": {
          "Ref": "Source1"
        },
        "Description": "CloudFront origin to temporary ALB"
      }
    },
    "ApplicationIngress2": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Advertisement to private common authentication TLS",
          "must": [
            "Existing owned destination group only",
            "No unrestricted CIDR",
            "Remove this stack before deleting foundation groups"
          ]
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "TargetGroup2"
        },
        "IpProtocol": "tcp",
        "FromPort": 8443,
        "ToPort": 8443,
        "CidrIp": {
          "Ref": "Source2"
        },
        "Description": "Advertisement to private common authentication TLS"
      }
    },
    "ApplicationIngress3": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Advertisement to private common authentication TLS",
          "must": [
            "Existing owned destination group only",
            "No unrestricted CIDR",
            "Remove this stack before deleting foundation groups"
          ]
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "TargetGroup3"
        },
        "IpProtocol": "tcp",
        "FromPort": 8443,
        "ToPort": 8443,
        "CidrIp": {
          "Ref": "Source3"
        },
        "Description": "Advertisement to private common authentication TLS"
      }
    }
  }
}