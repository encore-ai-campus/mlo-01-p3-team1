{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Application-only network additions for the existing cluster; preserve all foundation stacks and databases.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "TargetGroup1": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "Source1": {
      "Type": "String",
      "AllowedPattern": "\\d{1,3}(\\.\\d{1,3}){3}/32"
    },
    "TargetGroup2": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "Source2": {
      "Type": "String",
      "AllowedPattern": "\\d{1,3}(\\.\\d{1,3}){3}/32"
    }
  },
  "Resources": {
    "ApplicationIngress1": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Control gateway to advertisement API",
          "must": [
            "Existing owned destination group only",
            "No unrestricted CIDR",
            "Remove this stack before deleting foundation groups"
          ]
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "TargetGroup1"
        },
        "IpProtocol": "tcp",
        "FromPort": 8000,
        "ToPort": 8000,
        "CidrIp": {
          "Ref": "Source1"
        },
        "Description": "Control gateway to advertisement API"
      }
    },
    "ApplicationIngress2": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Control gateway to advertisement API",
          "must": [
            "Existing owned destination group only",
            "No unrestricted CIDR",
            "Remove this stack before deleting foundation groups"
          ]
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "TargetGroup2"
        },
        "IpProtocol": "tcp",
        "FromPort": 8000,
        "ToPort": 8000,
        "CidrIp": {
          "Ref": "Source2"
        },
        "Description": "Control gateway to advertisement API"
      }
    }
  }
}