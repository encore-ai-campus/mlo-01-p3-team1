                "is_test",
                "created_at",
                "title",
                "link_url",
                "asset_id",
                "creative_version",
                "placement",
                "starts_at",
                "ends_at",
                "priority",
                "version",
                "paused",
                "stopped_at",
                "created_by_account_id",
                "updated_by_account_id",
                "identity_source",
                "updated_at"
              ],
              "additionalProperties": false,
              "properties": {
                "_id": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "schema_version": {
                  "bsonType": "string",
                  "enum": [
                    "phase3-ads-data-20261014.3"
                  ]
                },
                "is_test": {
                  "bsonType": "bool"
                },
                "created_at": {
                  "bsonType": "date"
                },
                "title": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "link_url": {
                  "bsonType": "string",
                  "pattern": "^https://[^/\\s?#]+"
                },
                "asset_id": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "creative_version": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "placement": {
                  "bsonType": "string",
                  "enum": [
                    "top",
                    "bottom"
                  ]
                },
                "starts_at": {
                  "bsonType": "date"
                },
                "ends_at": {
                  "bsonType": "date"
                },
                "priority": {
                  "bsonType": [
                    "int",
                    "long"
                  ]
                },
                "version": {
                  "bsonType": [
                    "int",
                    "long"
                  ],
                  "minimum": 1
                },
                "paused": {
                  "bsonType": "bool"
                },
                "stopped_at": {
                  "bsonType": [
                    "date",
                    "null"
                  ]
                },
                "created_by_account_id": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "updated_by_account_id": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "identity_source": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "updated_at": {
                  "bsonType": "date"
                }
              }
            }
          },
          {
            "$expr": {
              "$lt": [
                "$starts_at",
                "$ends_at"
              ]
            }
          }
        ]
      },
      "indexes": [
        {
          "name": "candidate_lookup",
          "keys": [
            [
              "placement",
              1
            ],
            [
              "paused",
              1
            ],
            [
              "priority",
              -1
            ],
            [
              "starts_at",
              1
            ],
            [
              "ends_at",
              1
            ]
          ]
        },
        {
          "name": "admin_updated_list",
          "keys": [
            [
              "updated_at",
              -1
            ],
            [
              "_id",
              -1
            ]
          ]
        }
      ]
    },
    "ad_assets": {
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": [
