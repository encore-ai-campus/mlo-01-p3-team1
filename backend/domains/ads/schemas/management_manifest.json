              "bsonType": "string",
              "minLength": 1
            },
            "schema_version": {
              "bsonType": "string",
              "enum": [
                "phase3-ads-data-20261014.3"
              ]
            },
            "is_test": {
              "bsonType": "bool"
            },
            "created_at": {
              "bsonType": "date"
            },
