                  "bsonType": [
                    "string",
                    "null"
                  ]
                },
                "asset_id": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "identity_source": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "actor_account_id": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "resource_scope": {
                  "bsonType": "string",
                  "minLength": 1
                },
                "idempotency_key_hash": {
                  "bsonType": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "request_hash": {
                  "bsonType": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "changed": {
                  "bsonType": "bool"
                },
                "version_before": {
                  "bsonType": [
                    "int",
                    "long",
                    "null"
                  ],
                  "minimum": 1
                },
                "version_after": {
                  "bsonType": [
                    "int",
                    "long",
                    "null"
                  ],
                  "minimum": 1
                },
                "before_snapshot": {
                  "bsonType": [
                    "object",
                    "null"
                  ]
                },
                "after_snapshot": {
                  "bsonType": "object"
                },
            "reason": {
              "bsonType": ["string", "null"]
            },
                "response_snapshot": {
                  "bsonType": "object",
                  "required": [
                    "http_status",
                    "body"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "http_status": {
                      "bsonType": [
                        "int",
                        "long"
                      ],
                      "minimum": 200,
                      "maximum": 299
                    },
                    "body": {
                      "bsonType": "object"
                    }
                  }
                },
                "completed_at": {
                  "bsonType": "date"
                },
                "occurred_at": {
                  "bsonType": "date"
                },
