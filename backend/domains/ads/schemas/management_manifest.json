                        "null"
                      ]
                    },
                    "sent_at": {
                      "bsonType": [
                        "date",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "$expr": {
              "$cond": [
                {
                  "$eq": [
                    "$operation",
                    "UPLOAD_ASSET"
                  ]
                },
                {
                  "$eq": [
                    "$ad_id",
                    null
                  ]
                },
                {
                  "$ne": [
                    "$ad_id",
                    null
                  ]
                }
              ]
            }
          }
        ]
