# Actual values must be supplied outside version control. This file is not auto-loaded.
C_LOCAL_DEMO=1
# For integrated mode, unset C_LOCAL_DEMO and configure B/A/INF adapters.
DJANGO_SECRET_KEY=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432
OWNER_RESOLVER=
WEATHER_PROVIDER=
EVENT_SINK=
SEARCH_MAX_CANDIDATES=
SEARCH_SECONDS=
# Gemini is for explicit regeneration only.
GEMINI_ENABLED=0
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=
GEMINI_MAX_CANDIDATES=
GEMINI_MAX_OUTPUT_TOKENS=
# KEYLESS uses the local reviewed video registry; no API key or LLM required.
YOUTUBE_PLAYBACK_MODE=KEYLESS
# Optional official search requires an explicit OPTIONAL_SEARCH mode. Keep the key server-side.
# This example is not auto-loaded; supply process environment before starting the API.
YOUTUBE_DATA_API_KEY=
YOUTUBE_SEARCH_TIMEOUT_SECONDS=8
YOUTUBE_SEARCH_PER_OWNER_MINUTE=6
YOUTUBE_SEARCH_DAILY_LIMIT=80
YOUTUBE_SEARCH_CACHE_SECONDS=21600
