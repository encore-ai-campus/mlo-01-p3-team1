# backend/.env is loaded as data; explicit process environment takes precedence.
C_LOCAL_DEMO=0
# Integrated mode: C_LOCAL_DEMO=0, INTEGRATION_ENABLED=1; configure PostgreSQL + ES.
INTEGRATION_ENABLED=1
# Synthetic-only demo: C_LOCAL_DEMO=1, INTEGRATION_ENABLED=0 and omit the three adapter overrides.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432
PGSSLMODE=verify-full
PGSSLROOTCERT=
PGCONNECT_TIMEOUT=5
# Use built-in adapters unless an explicitly verified replacement is supplied.
OWNER_RESOLVER=backend.common.identity.owner
WEATHER_PROVIDER=backend.weather.adapter.obtain
# 실제 로컬 날씨: WEATHER_PROVIDER=backend.weather.live.obtain
# 별도 실행: python -m pipeline.weather.live_cache (HTTP에서 기상청을 직접 호출하지 않음)
# KMA_LOCAL_CACHE_PATH를 생략하면 프로젝트의 .local/weather-live/latest.json 사용
EVENT_SINK=backend.common.events.record
GUEST_TTL_SECONDS=
ADMIN_SESSION_SECONDS=
# Optional first account only; existing accounts/passwords/permissions are preserved.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PERMISSIONS=
BOOTSTRAP_ADMIN_ROLE=
# OIDC SSO: defaults OFF until IdP, HTTPS and Elastic OIDC license are verified.
ADMIN_SSO_ENABLED=0
# Leave blank to follow SSO mode: local password OFF when SSO is ON.
ADMIN_LOCAL_LOGIN_ENABLED=
ADMIN_SSO_ISSUER=
ADMIN_SSO_CLIENT_ID=
ADMIN_SSO_CLIENT_SECRET=
ADMIN_SSO_REDIRECT_URI=
ADMIN_SSO_POST_LOGOUT_URI=
ADMIN_SSO_GROUPS_CLAIM=groups
ADMIN_SSO_KEYCLOAK_ADMIN_URL=
ADMIN_KIBANA_URL=
# Separate targets. ADMIN_KIBANA_URL is a legacy fallback for operations only.
ADMIN_OPERATIONS_DASHBOARD_URL=
ADMIN_LOG_DASHBOARD_URL=
# Required for native (non-SSO) Kibana links: comma-separated HTTPS hostnames, no schemes.
ADMIN_KIBANA_ALLOWED_HOSTS=
ADMIN_SSO_ELASTICSEARCH_URL=
# Provisioning token is needed only by the explicit lifecycle command.
ADMIN_SSO_PROVISION_TOKEN=
ADMIN_SSO_INITIAL_PASSWORD=
# Server-only key with token invalidation privileges. Never expose to the browser.
ADMIN_SSO_ELASTIC_API_KEY=
# Shared only between common host and advertisement host, never browser-visible.
ADS_INTERNAL_SECRET=
CSV_UPLOAD_MAX_BYTES=
MUSIC_RAW_DIRECTORY=
MUSIC_S3_BUCKET=
MUSIC_S3_REGION=
MUSIC_S3_PREFIX=
# Explicit deployment policy: preserve local originals while S3 archiving is pending.
# Does not turn on demo mode or mark S3 storage as verified.
MUSIC_S3_ARCHIVE_DEFERRED=0
FEEDBACK_KAFKA_BOOTSTRAP=
FEEDBACK_KAFKA_TOPIC=
FEEDBACK_KAFKA_TOPIC_PARTITIONS=
FEEDBACK_KAFKA_REPLICATION_FACTOR=
FEEDBACK_KAFKA_GROUP=
FEEDBACK_KAFKA_SECURITY_PROTOCOL=SASL_SSL
FEEDBACK_KAFKA_SSL_CAFILE=
FEEDBACK_KAFKA_SASL_MECHANISM=PLAIN
FEEDBACK_KAFKA_SASL_USERNAME=
FEEDBACK_KAFKA_SASL_PASSWORD=
FEEDBACK_KAFKA_OPTIONS_FILE=
FEEDBACK_CHECKPOINT_PATH=
ES_URL=
ES_USERNAME=
ES_PASSWORD=
ES_CA_CERT=
WEATHER_INDEX=
WEATHER_MAPPING_DSN=
SEARCH_MAX_CANDIDATES=
SEARCH_SECONDS=
# Shared queue controls: use the same limits on both API/worker hosts.
RECOMMENDATION_QUEUE=all
RECOMMENDATION_WORKER_ID=
RECOMMENDATION_WORKER_IDLE_SECONDS=1
RECOMMENDATION_LEASE_SECONDS=30
RECOMMENDATION_HEARTBEAT_SECONDS=10
RECOMMENDATION_JOB_TIMEOUT_SECONDS=180
RECOMMENDATION_MAX_RECOVERIES=2
RECOMMENDATION_MAX_QUEUED_RULE=100
RECOMMENDATION_MAX_QUEUED_GEMINI=20
GEMINI_MAX_CONCURRENT=1
GEMINI_MIN_INTERVAL_SECONDS=2
# Explicit regeneration only, including provided-CSV results.
# These five names are also read from backend/.env; process env takes precedence.
GEMINI_ENABLED=0
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=
GEMINI_MAX_CANDIDATES=
GEMINI_MAX_OUTPUT_TOKENS=
# KEYLESS uses the local reviewed video registry; no API key or LLM required.
YOUTUBE_PLAYBACK_MODE=KEYLESS
# Optional official search requires an explicit OPTIONAL_SEARCH mode. Keep the key server-side.
# This example is not auto-loaded; supply process environment before starting the API.
YOUTUBE_DATA_API_KEY=
YOUTUBE_SEARCH_TIMEOUT_SECONDS=8
YOUTUBE_SEARCH_PER_OWNER_MINUTE=6
YOUTUBE_SEARCH_DAILY_LIMIT=80
YOUTUBE_SEARCH_CACHE_SECONDS=21600
# One-time initialization sources. Import preserves draft review status.
MUSIC_SOURCE_PATH=docs/handoff/music/spotify_dataset.csv
MUSIC_SOURCE_SCHEMA=spotify-raw20-v1
MUSIC_SOURCE_SHA256=
MUSIC_CATALOG_VERSION=
