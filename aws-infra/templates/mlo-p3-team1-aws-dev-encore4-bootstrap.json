              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "node-storage",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetBucketLocation",
                  "Resource": "arn:aws:s3:::mlo-p3-team1-aws-dev-444444444444-artifacts"
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": "arn:aws:s3:::mlo-p3-team1-aws-dev-444444444444-artifacts",
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "public/*",
