              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "node-storage",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetBucketLocation",
                  "Resource": "arn:aws:s3:::mlo-p3-team1-aws-dev-444444444444-artifacts"
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": "arn:aws:s3:::mlo-p3-team1-aws-dev-444444444444-artifacts",
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "public/*",
                        "private/kafka-03/*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": [
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-444444444444-artifacts/public/*",
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-444444444444-artifacts/private/kafka-03/*"
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "mlo-p3-team1"
          },
          {
            "Key": "Environment",
            "Value": "aws-dev"
          },
          {
            "Key": "Node",
            "Value": "kafka-03"
          },
          {
            "Key": "Role",
            "Value": "kafka"
          }
        ]
      }
    },
    "Kafka03Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate named instance profile for this logical node.",
          "must": []
        }
      },
      "Properties": {
        "InstanceProfileName": "mlo-p3-team1-aws-dev-kafka-03-runtime",
        "Roles": [
          {
