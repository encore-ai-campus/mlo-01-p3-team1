                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                  ],
                  "Resource": "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-checkpoints/aws/aws-dev/*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "mlo-p3-team1"
          },
          {
            "Key": "Environment",
            "Value": "aws-dev"
          },
          {
            "Key": "Node",
            "Value": "spark-03"
          },
          {
            "Key": "Role",
            "Value": "spark"
          }
        ]
      }
    },
    "Spark03Profile": {
