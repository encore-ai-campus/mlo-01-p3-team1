    "OperatorPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Project CloudFormation/SSM operations and regional validation-event reads on the existing team role.",
          "must": [
            "Administrator applies; preserves existing role trust and EC2 managed policies."
          ]
        }
      },
      "Properties": {
        "ManagedPolicyName": "mlo-p3-team1-aws-dev-operator",
        "Roles": [
          "ProjectInfraRole"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
