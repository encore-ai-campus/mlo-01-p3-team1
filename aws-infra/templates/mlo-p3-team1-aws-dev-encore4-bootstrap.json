                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": [
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-444444444444-artifacts/public/*",
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-444444444444-artifacts/private/spark-03/*"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetBucketLocation",
                  "Resource": "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-checkpoints"
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-checkpoints",
                  "Condition": {
