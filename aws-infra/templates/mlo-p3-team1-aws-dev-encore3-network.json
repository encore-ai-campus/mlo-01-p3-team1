{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "One private project VPC, three AZ-ID subnet pairs, one zonal NAT, S3 endpoint and stable per-node ENIs.",
  "Metadata": {
    "ProjectCodeVersion": "0.3.20",
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "ref": [
        "../README.md",
        "../SECURITY.md",
        "../../docs/handoff/infra/README.md"
      ],
      "must": [
        "Five independent accounts; 14 private EC2 nodes; three physical AZ IDs.",
        "No local VM operations. No secrets or CA private key in templates."
      ]
    }
  },
  "Parameters": {
    "AzA": {
      "Type": "String",
      "AllowedPattern": "apne2-az[1-4]"
    },
    "AzB": {
      "Type": "String",
      "AllowedPattern": "apne2-az[1-4]"
    },
    "AzC": {
      "Type": "String",
      "AllowedPattern": "apne2-az[1-4]"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Independent non-overlapping account VPC.",
          "must": [
            "Review connected local/VPN CIDRs before apply."
          ]
        }
      },
      "Properties": {
        "CidrBlock": "10.82.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "mlo-p3-team1"
          },
          {
            "Key": "Environment",
            "Value": "aws-dev"
          },
          {
            "Key": "Node",
            "Value": "shared"
          },
          {
            "Key": "Role",
            "Value": "infrastructure"
          }
        ]
      }
    },
    "AccepterPolicy": {
      "Type": "AWS::IAM::Policy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Binds the current VPC inside the network stack, so every create/delete cycle needs no account-owner intervention.",
          "must": [
            "The accepter permissions boundary and trust are administrator-owned.",
            "Remove peer stacks before deleting this network-owned policy."
          ]
        }
      },
      "Properties": {
        "PolicyName": "mlo-p3-team1-aws-dev-accept-project-vpc",
        "Roles": [
          "mlo-p3-team1-aws-dev-peering-accepter"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "ec2:AcceptVpcPeeringConnection",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:vpc/${Vpc}"
              }
            },
            {
              "Effect": "Allow",
              "Action": "ec2:AcceptVpcPeeringConnection",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:vpc-peering-connection/*"
              },
              "Condition": {
                "ArnEquals": {
                  "ec2:AccepterVpc": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:vpc/${Vpc}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Outbound Internet via project NAT and future public ALB.",
          "must": []
