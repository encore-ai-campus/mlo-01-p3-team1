    "OperatorRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Scoped operator from encore1 login; regional validation-event reads; student remains bootstrap administrator.",
          "must": [
            "SignInSessionArn is session context presence, not a direct MFA proof."
          ]
        }
      },
      "Properties": {
        "RoleName": "mlo-p3-team1-aws-dev-operator",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::111111111111:user/REPLACE_ME"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "Null": {
                  "aws:SignInSessionArn": "false"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "project-operations",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeChangeSet",
                    "cloudformation:DeleteChangeSet",
                    "cloudformation:ExecuteChangeSet",
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackResources",
                    "cloudformation:ListStackResources",
                    "cloudformation:DeleteStack",
                    "cloudformation:GetTemplate",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:DescribeEvents",
                    "cloudformation:ListChangeSets"
                  ],
                  "Resource": [
                    "arn:aws:cloudformation:ap-northeast-2:111111111111:stack/mlo-p3-team1-aws-dev-encore1-*/*"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:CreateChangeSet",
                  "Resource": "arn:aws:cloudformation:ap-northeast-2:111111111111:stack/mlo-p3-team1-aws-dev-encore1-*/*",
                  "Condition": {
                    "ArnEquals": {
                      "cloudformation:RoleArn": "arn:aws:iam::111111111111:role/mlo-p3-team1-aws-dev-cfn-execution"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:ListStacks",
                    "cloudformation:ValidateTemplate",
                    "cloudformation:GetTemplateSummary"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": "arn:aws:iam::111111111111:role/mlo-p3-team1-aws-dev-cfn-execution",
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeVpcs",
                    "ec2:DescribeVpcAttribute",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeRouteTables",
                    "ec2:DescribeInternetGateways",
                    "ec2:DescribeAddresses",
                    "ec2:DescribeNatGateways",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeSecurityGroupRules",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DescribeVpcEndpoints",
                    "ec2:DescribeVpcPeeringConnections",
                    "ec2:DescribeInstances",
                    "ec2:DescribeInstanceAttribute",
                    "ec2:DescribeInstanceStatus",
                    "ec2:DescribeVolumes",
                    "ec2:DescribeImages",
                    "ec2:DescribeTags",
                    "ec2:DescribeInstanceCreditSpecifications",
                    "ec2:DescribeLaunchTemplates",
                    "ec2:DescribeLaunchTemplateVersions",
                    "ec2:DescribeIamInstanceProfileAssociations",
                    "ec2:DescribeKeyPairs",
                    "ec2:DescribeNetworkAcls",
                    "ec2:DescribeVpnGateways",
                    "ec2:DescribeAvailabilityZones",
                    "ec2:DescribeInstanceTypes",
                    "ec2:DescribeInstanceTypeOfferings"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-2"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:DescribeInstanceInformation",
                    "ssm:GetCommandInvocation",
                    "ssm:ListCommands",
                    "ssm:ListCommandInvocations"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-2"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": "arn:aws:ec2:ap-northeast-2:111111111111:instance/*",
                  "Condition": {
                    "StringEquals": {
                      "ssm:resourceTag/Project": "mlo-p3-team1",
                      "ssm:resourceTag/Environment": "aws-dev"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    "arn:aws:ssm:ap-northeast-2::document/AWS-RunShellScript",
                    "arn:aws:ssm:ap-northeast-2::document/AWS-RunRemoteScript"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "servicequotas:GetServiceQuota",
                  "Resource": "arn:aws:servicequotas:ap-northeast-2:111111111111:ec2/L-1216C47A"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": [
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-artifacts",
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-checkpoints"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-artifacts/*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketTagging",
                    "s3:ListBucketVersions",
                    "s3:ListBucketMultipartUploads",
                    "s3:DeleteBucket"
                  ],
                  "Resource": [
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-artifacts",
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-checkpoints"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:DeleteObject",
                    "s3:DeleteObjectVersion",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": [
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-artifacts/*",
                    "arn:aws:s3:::mlo-p3-team1-aws-dev-111111111111-checkpoints/*"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "elasticloadbalancing:DescribeLoadBalancers",
                    "elasticloadbalancing:DescribeTargetGroups",
                    "elasticloadbalancing:DescribeTargetHealth",
                    "elasticloadbalancing:DescribeTags"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "acm:DescribeCertificate",
                  "Resource": "arn:aws:acm:ap-northeast-2:111111111111:certificate/*"
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeEvents",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-2"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "mlo-p3-team1"
          },
          {
            "Key": "Environment",
            "Value": "aws-dev"
          },
          {
            "Key": "Node",
            "Value": "shared"
          },
          {
            "Key": "Role",
            "Value": "infrastructure"
          }
        ]
      }
    }
  },
