# Django 개발 DB, 사용자 업로드와 collectstatic 결과
/db.sqlite3
/db.sqlite3-*
/backend/db.sqlite3
/backend/db.sqlite3-*
/media/
/staticfiles/
/backend/media/
/backend/staticfiles/

# React, TypeScript, Vite 의존성과 빌드 결과
node_modules/
.vite/
*.tsbuildinfo
/frontend/dist/
/frontend/build/
npm-debug.log*
