yarn-error.log*
pnpm-debug.log*

# 로컬 원본 데이터, 실행 상태, 로그, 백업과 임시 산출물
*.log
/data/
/logs/
/runtime/
/tmp/
/temp/
/artifacts/
/checkpoints/
/backups/
/uploads/
/pipeline/*/data/
/pipeline/*/logs/
/pipeline/*/checkpoints/
