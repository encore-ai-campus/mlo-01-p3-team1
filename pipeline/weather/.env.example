# KMA_API_KEY: process environment first, then this package's .env (single line).
# Collector/Spark/preparation load supported names from this file; process env wins.
KMA_API_KEY=
KAFKA_BOOTSTRAP=
KAFKA_TOPIC=weather.v1
KAFKA_TOPIC_PARTITIONS=
KAFKA_REPLICATION_FACTOR=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SSL_CAFILE=
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Secret JSON Kafka options for the Spark JVM; keep outside the repository.
WEATHER_KAFKA_OPTIONS_FILE=
# Latest weather, shared features and both public/music reads use ES.
ES_URL=
ES_USERNAME=
ES_PASSWORD=
ES_CA_CERT=
# Required operator-selected index. Local source example: weather-stream-current-v1-local.
# Prepare schema_version/revision/state_hash/stored_at, rows (enabled:false), view.
# Legacy administrator-only indexes are incompatible with this storage envelope.
WEATHER_INDEX=
WEATHER_LOG_ES_URL=
WEATHER_LOG_INDEX=pipeline-logs-v1
WEATHER_STATE_DIR=
WEATHER_PROCESS_LOG_PATH=
CHECKPOINT_PATH=
SPARK_MASTER=
SPARK_SUBMIT=spark-submit
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.6
# EC2 PostgreSQL private address. DSN OR PG* fields, no localhost fallback.
WEATHER_MAPPING_DSN=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Match server TLS policy; verify-full + PGSSLROOTCERT when configured.
PGSSLMODE=prefer
SPARK_DRIVER_HOST=
PGSSLROOTCERT=

# Existing microbatch behavior retained; available_now drains backlog then exits.
# Production scheduling and Driver host require INF confirmation.
WEATHER_SPARK_MODE=microbatch
WEATHER_SPARK_INTERVAL=15 seconds
# No weather MongoDB, raw response archive or duplicated PostgreSQL observations.
# Personal normalized history format/retention remains undecided.
