# Export via EC2 service environment. Not loaded automatically.
KMA_API_KEY=
KAFKA_BOOTSTRAP=
KAFKA_TOPIC=weather.v1
# Administrator publisher only. User queries do not require ES.
ES_URL=
# First deployment: prepare a NEW admin index; do not reuse the old internal-version index.
WEATHER_INDEX=weather-admin-current-v1
WEATHER_LOG_ES_URL=
WEATHER_LOG_INDEX=pipeline-logs-v1
WEATHER_STATE_DIR=
WEATHER_PROCESS_LOG_PATH=
CHECKPOINT_PATH=
SPARK_MASTER=
SPARK_SUBMIT=spark-submit
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.6
# EC2 PostgreSQL private address. DSN OR PG* fields, no localhost fallback.
WEATHER_MAPPING_DSN=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Match server TLS policy; verify-full + PGSSLROOTCERT when configured.
PGSSLMODE=prefer
SPARK_DRIVER_HOST=
PGSSLROOTCERT=

# Separate credentials for query / Driver writer / administrator publisher.
# Configure replicaSet, authSource, TLS/CA in each URI to match INF settings.
# No localhost or advertisement credential fallback.
WEATHER_MONGODB_READ_URI=
WEATHER_MONGODB_WRITE_URI=
WEATHER_MONGODB_PUBLISH_URI=
WEATHER_MONGODB_DATABASE=
# Proposed latest-bundle collection; prepare explicitly before starting.
WEATHER_MONGODB_COLLECTION=weather_current
# Existing microbatch behavior retained; available_now drains backlog then exits.
# Production scheduling and Driver host require INF confirmation.
WEATHER_SPARK_MODE=microbatch
WEATHER_SPARK_INTERVAL=15 seconds
WEATHER_ADMIN_POLL_SECONDS=15
# Raw EBS/S3 and long-term history remain pending; no new storage enabled.
