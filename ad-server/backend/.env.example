# 로컬 개발 전용 예시. 실제 값은 추적하지 않는 ad-server/backend/.env에 둡니다.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=cafe_common_dev
POSTGRES_USER=cafe_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
ADS_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=ads-rs&directConnection=true
ADS_MONGODB_DATABASE=advertising_dev
ADS_IS_TEST=1
# 공유 인증 담당자가 제공하는 서버 callable의 import 경로. 테스트 역할/ID 헤더를 쓰지 않습니다.
ADS_ADMIN_AUTHORIZER=
# 공통 PostgreSQL 멱등 로그 저장 완료를 확인하는 서버 callable의 import 경로.
ADS_LOG_SINK=
# 담당자가 확정한 공통 응답 버전. 보류 상태에서 기존 이벤트 버전을 임의 덮어쓰지 않습니다.
ADS_API_CONTRACT_VERSION=
# 공통 익명 문맥 callable(raw_request, bootstrap=bool). 쿠키 발급은 이 어댑터에 위임합니다.
ADS_GUEST_CONTEXT_PROVIDER=
# 명시 AdsPublicPolicy를 반환하는 서버 callable. 운영 수명/예산/소재 변경 값은 미정입니다.
ADS_PUBLIC_POLICY_PROVIDER=domains.ads.runtime_policy.get_public_policy
# 배달 proof 서명용 별도 비밀 키와 외부에서 접근 가능한 광고 서버의 기본 HTTPS URL.
ADS_DELIVERY_SIGNING_KEY=
ADS_PUBLIC_BASE_URL=
