    "FeedbackEventEnvelope": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "enum": [
            "TRACK_REACTION_CHANGED",
            "TRACK_REACTION_CLEARED",
            "PLAYLIST_RATING_CHANGED",
            "PLAYLIST_RATING_CLEARED"
          ]
        },
        "contract_version": {
          "const": "phase3-20261014.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "source_playlist_id": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "enum": [
            "TRACK_REACTION",
            "PLAYLIST_RATING"
          ]
        },
        "target_revision": {
          "type": "integer",
          "minimum": 1
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "previous_value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "new_value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "related_feedback_event_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "is_test": {
          "type": "boolean"
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "track_snapshot_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "event_id",
        "event_type",
        "contract_version",
        "request_id",
        "owner_id",
        "family_id",
        "source_playlist_id",
        "target_kind",
        "target_revision",
        "previous_value",
        "new_value",
        "related_feedback_event_id",
        "occurred_at",
        "is_test",
        "context_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "TRACK_REACTION"
              }
            }
          },
          "then": {
            "required": [
              "track_id",
              "track_snapshot_ref"
            ],
            "properties": {
              "event_type": {
                "enum": [
                  "TRACK_REACTION_CHANGED",
                  "TRACK_REACTION_CLEARED"
                ]
              },
              "previous_value": {
                "enum": [
                  "LIKE",
                  "DISLIKE",
                  null
                ]
              },
              "new_value": {
                "enum": [
                  "LIKE",
                  "DISLIKE",
                  null
                ]
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "track_id"
                  ]
                },
                {
                  "required": [
                    "track_snapshot_ref"
                  ]
                }
              ]
            },
            "properties": {
              "event_type": {
                "enum": [
                  "PLAYLIST_RATING_CHANGED",
                  "PLAYLIST_RATING_CLEARED"
                ]
              },
              "previous_value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "new_value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "enum": [
                  "TRACK_REACTION_CLEARED",
                  "PLAYLIST_RATING_CLEARED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "new_value": {
                "type": "null"
              },
              "previous_value": {
                "not": {
                  "type": "null"
                }
              },
              "related_feedback_event_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "new_value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "JobStatusResponse": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "EXPIRED"
          ]
        },
        "playlist_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorResponse"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_id",
        "status",
        "playlist_id",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "QUEUED",
                  "RUNNING"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "playlist_id": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUCCEEDED"
              }
            }
          },
          "then": {
            "properties": {
              "playlist_id": {
                "type": "string",
                "minLength": 1
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "FAILED",
                  "EXPIRED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "playlist_id": {
                "type": "null"
              },
              "error": {
                "$ref": "#/$defs/ErrorResponse"
              }
            }
          }
        }
      ]
    },
