          "minLength": 1
        },
        "option_version": {
          "type": "string",
          "minLength": 1
        },
        "vocal_option": {
          "type": "string",
          "enum": [
            "any",
            "instrumental_only"
          ]
        },
        "tempo_preference": {
          "type": "string",
          "enum": [
            "auto",
            "slow",
            "fast"
          ]
        },
        "selected_theme_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_genre_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_track_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 0
        }
      },
      "required": [
        "region_id"
      ],
      "additionalProperties": false
    },
    "RegenerationRequest": {
      "type": "object",
      "properties": {
        "exclusion_revision": {
          "type": "integer",
          "minimum": 0
        },
        "option_version": {
          "type": "string",
          "minLength": 1
        },
        "vocal_option": {
          "type": "string",
          "enum": [
            "any",
            "instrumental_only"
          ]
        },
        "tempo_preference": {
          "type": "string",
          "enum": [
            "auto",
            "slow",
            "fast"
          ]
        },
        "selected_theme_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_genre_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
