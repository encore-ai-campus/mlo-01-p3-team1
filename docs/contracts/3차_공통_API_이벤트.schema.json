    "MusicNormalizedTrack": {
      "type": "object",
      "description": "수령18개 추천/표시+검수보조1개의 논리행입니다. 저장duration0은 허용하지만 추천에서는양수만. 원본20개+인덱스 입력과 구분하여 이중변환하지 않습니다.",
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "track_name": {
          "type": "string",
          "minLength": 1
        },
        "artists_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "artists_name": {
          "type": "string",
          "minLength": 1
        },
        "album_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "album_name": {
          "type": "string",
          "minLength": 1
        },
        "album_release_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "explicit": {
          "type": "boolean"
        },
        "genre": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "energy": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "mode": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "acousticness": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "mood": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "speed": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "slow",
            "medium",
            "fast",
            "fastest",
            null
          ]
        },
        "main_inst": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "instrumental": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "play_url": {
          "type": "string",
          "pattern": "^https://open\\.spotify\\.com/track/[^/\\s?#]+$"
        },
        "instrumental_review_value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "track_id",
        "track_name",
        "artists_id",
        "artists_name",
        "album_id",
        "album_name",
        "album_release_date",
        "duration_ms",
        "explicit",
        "genre",
        "energy",
        "mode",
        "acousticness",
        "mood",
        "speed",
        "main_inst",
        "instrumental",
        "play_url",
        "instrumental_review_value"
      ],
      "additionalProperties": false
    },
    "MusicCycleSnapshot": {
      "type": "object",
      "description": "family를 수령음악사이클로 대응합니다. 초기선택·허용집합·버전은동일사이클에서불변입니다.",
      "properties": {
        "family_id": {
          "type": "string",
